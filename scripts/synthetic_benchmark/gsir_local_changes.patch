-        fovy = focal2fov(fov2focal(fovx, image.size[0]), image.size[1])
-        FovY = fovy
-        FovX = fovx
+        # Per-frame intrinsics take precedence over the file-level value:
+        # NeuSky synthetic scenes vary focal length per frame (train fl_x
+        # spans ~1871-3732 px), and a single global camera_angle_x silently
+        # corrupts every camera (up to ~40% focal error).
+        if "camera_angle_x" in frame:
+            FovX = frame["camera_angle_x"]
+        elif "fl_x" in frame:
+            FovX = focal2fov(float(frame["fl_x"]), image.size[0])
+        elif fovx is not None:
+            FovX = fovx
+        else:
+            raise ValueError(
+                f"{transformsfile}: frame {idx} has no camera_angle_x/fl_x and "
+                "no file-level camera_angle_x fallback"
+            )
+        if "fl_y" in frame:
+            FovY = focal2fov(float(frame["fl_y"]), image.size[1])
+        else:
+            FovY = focal2fov(fov2focal(FovX, image.size[0]), image.size[1])
 
