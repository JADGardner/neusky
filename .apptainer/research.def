BootStrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

%labels
    Author James Gardner
    Description NeuSky research container (nerfstudio + tiny-cuda-nn + nvdiffrast)

%post
    export DEBIAN_FRONTEND=noninteractive
    CUDA_ARCHITECTURES="90;89;86;80"
    NERFSTUDIO_COMMIT="50e0e3c70c775e89333256213363badbf074f29d"

    # Disable apt sandbox privilege dropping (fails in rootless/fakeroot builds)
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/01-no-sandbox

    # -- System dependencies ------------------------------------------------------
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        git \
        wget \
        curl \
        bzip2 \
        ca-certificates \
        libopenexr-dev \
        openexr \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        ffmpeg \
        && rm -rf /var/lib/apt/lists/*

    # -- Miniconda (arch-aware) ---------------------------------------------------
    ARCH="$(uname -m)"
    case "${ARCH}" in
        x86_64)  MINICONDA_ARCH="Linux-x86_64" ;;
        aarch64) MINICONDA_ARCH="Linux-aarch64" ;;
        *)       echo "Unsupported architecture: ${ARCH}"; exit 1 ;;
    esac
    CONDA_DIR=/opt/conda
    wget --quiet "https://repo.anaconda.com/miniconda/Miniconda3-latest-${MINICONDA_ARCH}.sh" \
        -O /tmp/miniconda.sh
    /bin/bash /tmp/miniconda.sh -b -p "${CONDA_DIR}"
    rm /tmp/miniconda.sh
    export PATH="${CONDA_DIR}/bin:${PATH}"

    # -- Conda environment --------------------------------------------------------
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
    conda create -n research python=3.12 -y
    conda run -n research conda install -c conda-forge colmap sqlite ffmpeg ninja -y

    # -- PyTorch + CUDA 12.8 ------------------------------------------------------
    # x86_64 pins 2.8.0: prebuilt tinycudann/gsplat wheels exist for pt2.8.0cu128.
    # aarch64 (Isambard GH200) has no 2.8.0 cu128 wheel; 2.7.1 is the closest
    # release and keeps the pinned nerfstudio's API assumptions intact.
    ARCH="$(uname -m)"
    if [ "${ARCH}" = "aarch64" ]; then
        TORCH_PKGS="torch==2.7.1 torchvision==0.22.1 torchaudio==2.7.1"
    else
        TORCH_PKGS="torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0"
    fi
    conda run -n research pip install --no-cache-dir \
        ${TORCH_PKGS} \
        --index-url https://download.pytorch.org/whl/cu128

    # -- tiny-cuda-nn --------------------------------------------------------------
    # x86_64: prebuilt wheel (miropsota torch_packages_builder) avoids the fragile
    # source compile. aarch64: no prebuilt wheel exists; compile the torch bindings
    # from source (no GPU needed at build time - arch pinned to sm_90 for GH200).
    if [ "${ARCH}" = "aarch64" ]; then
        # tcnn's setup.py imports pkg_resources, removed in setuptools>=81.
        conda run -n research pip install --no-cache-dir "setuptools<81"
        conda run -n research bash -c " \
            export TCNN_CUDA_ARCHITECTURES=90 && export FORCE_CUDA=1 && \
            pip install --no-cache-dir --no-build-isolation \
            'git+https://github.com/NVlabs/tiny-cuda-nn/#subdirectory=bindings/torch'"
    else
        conda run -n research pip install --no-cache-dir \
            --extra-index-url https://miropsota.github.io/torch_packages_builder \
            "tinycudann==2.0+pt2.8.0cu128"
    fi

    # -- nvdiffrast (from source, with triton linking patch) ----------------------
    conda run -n research bash -c " \
        export TORCH_CUDA_ARCH_LIST='8.0;8.6;8.9;9.0+PTX' && \
        ln -sf \$CONDA_PREFIX/lib/python3.12/site-packages/triton/backends/nvidia/include/crt \$CONDA_PREFIX/include/ && \
        pip install --no-cache-dir --no-build-isolation git+https://github.com/NVlabs/nvdiffrast.git"

    # -- nerfstudio ---------------------------------------------------------------
    # Pin the exact revision verified with the released thesis implementation.
    # open3d ships no aarch64 wheels; nerfstudio only uses it for exporter
    # utilities NeuSky never touches, so drop it from the dep list on ARM.
    # TORCH_CUDA_ARCH_LIST lets nerfstudio's transitive gsplat build from source
    # when no matching wheel exists (aarch64).
    conda run -n research bash -c " \
        export TORCH_CUDA_ARCH_LIST='8.0;8.6;8.9;9.0+PTX' && \
        git init /opt/nerfstudio && \
        cd /opt/nerfstudio && \
        git remote add origin https://github.com/nerfstudio-project/nerfstudio.git && \
        git fetch --depth 1 origin ${NERFSTUDIO_COMMIT} && \
        git checkout --detach FETCH_HEAD && \
        if [ \"${ARCH}\" = aarch64 ]; then sed -i 's/\"open3d[^\"]*\",//' pyproject.toml; fi && \
        pip install --no-cache-dir -e ."

    # -- Scientific Python stack + NeuSky deps ------------------------------------
    conda run -n research pip install --no-cache-dir \
        numpy scipy pandas matplotlib seaborn \
        scikit-learn scikit-image \
        opencv-python-headless Pillow \
        tqdm wandb tensorboard \
        jupyterlab ipywidgets

    # -- 3D / NeRF packages -------------------------------------------------------
    # aarch64: open3d and pycolmap ship no ARM wheels. COLMAP itself comes from
    # conda above; pycolmap python bindings are only used by nerfstudio's data
    # processing utilities, not NeuSky's training/eval paths.
    if [ "${ARCH}" = "aarch64" ]; then
        conda run -n research pip install --no-cache-dir trimesh plyfile
    else
        conda run -n research pip install --no-cache-dir \
            open3d trimesh plyfile pycolmap
    fi

    # -- Shared nerfstudio deps ---------------------------------------------------
    conda run -n research pip install --no-cache-dir \
        tyro rich jaxtyping viser nerfview splines \
        einops pyyaml packaging requests

    # -- ns_reni deps -------------------------------------------------------------
    conda run -n research pip install --no-cache-dir \
        pyexr OpenEXR roma

    # -- neusky deps --------------------------------------------------------------
    conda run -n research pip install --no-cache-dir \
        icosphere wget yacs ftfy regex kaleido omegaconf

    # -- Third-party baseline deps (NeRF-OSR / GS-IR adapters) --------------------
    conda run -n research pip install --no-cache-dir \
        configargparse tensorboardX lpips kornia

    # -- Image I/O ----------------------------------------------------------------
    conda run -n research pip install --no-cache-dir \
        "imageio[all]"

    # nerfstudio CLI completions
    conda run -n research ns-install-cli || true

    # Clean conda cache
    conda clean -afy

    # NVIDIA driver stubs (Apptainer --nv injects real drivers at runtime)
    touch /usr/bin/nvidia-smi
    touch /usr/bin/nvidia-debugdump
    touch /usr/bin/nvidia-persistenced
    touch /usr/bin/nvidia-cuda-mps-control
    touch /usr/bin/nvidia-cuda-mps-server
    mkdir -p /run/nvidia-persistenced
    touch /run/nvidia-persistenced/socket

    # Overlay package directory
    mkdir -p /overlay-packages

    # Bind-mount targets for HPC
    mkdir -p /workspace/code /workspace/data /workspace/outputs /workspace/models /workspace/model-storage

%environment
    export CONDA_DIR=/opt/conda
    export PATH="/opt/conda/envs/research/bin:/opt/conda/bin:/usr/local/cuda/bin:${PATH}"
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH="/opt/conda/envs/research/lib/python3.12/site-packages/torch/lib:/opt/conda/envs/research/lib/python3.12/site-packages/nvidia/cudnn/lib:/opt/conda/envs/research/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"
    export PYTHONPATH="/overlay-packages:${PYTHONPATH}"

%test
    . /opt/conda/etc/profile.d/conda.sh
    conda activate research
    # CUDA won't be available during build (no --nv), so just check imports.
    python -c "import torch; print(f'PyTorch {torch.__version__}, CUDA compiled: {torch.version.cuda}')"
    python -c "import nerfstudio; print('nerfstudio OK')"
    python -c "import nvdiffrast; print('nvdiffrast OK')"

%runscript
    . /opt/conda/etc/profile.d/conda.sh
    conda activate research
    exec "$@"
